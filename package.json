{
  "name": "viem-oz-access-control",
  "version": "1.0.0",
  "description": "Viem extensions for OpenZeppelin AccessControl and DefaultAdminRules contracts",
  "keywords": [
    "access-control",
    "eth",
    "ethereum",
    "hemi",
    "hemilabs",
    "openzeppelin",
    "roles",
    "viem"
  ],
  "bugs": {
    "url": "https://github.com/hemilabs/viem-oz-access-control/issues"
  },
  "license": "MIT",
  "author": {
    "email": "gonzalo@hemi.xyz",
    "name": "Gonzalo D'Elia"
  },
  "files": [
    "_esm",
    "_types",
    "src/**/*.ts"
  ],
  "repository": "hemilabs/viem-oz-access-control",
  "scripts": {
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:types",
    "build:esm": "tsc --noEmit false --outDir ./_esm --sourceMap",
    "build:types": "tsc --noEmit false --declarationDir ./_types --emitDeclarationOnly --declaration --declarationMap",
    "clean": "rm -rf ./_esm ./_types",
    "deps:check": "knip",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint --cache .",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@tsconfig/node24": "^24.0.4",
    "@vitest/coverage-v8": "^4.1.2",
    "better-sort-github-actions": "^1.0.0",
    "better-sort-package-json": "^1.1.1",
    "commitlint-config-bloq": "^1.1.0",
    "eslint": "^8.57.1",
    "eslint-config-bloq": "^4.8.2",
    "husky": "^9.1.7",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "viem": "^2.55.19",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "viem": "^2.x"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./_types/index.d.ts",
      "import": "./_esm/index.js"
    },
    "./actions": {
      "types": "./_types/actions/index.d.ts",
      "import": "./_esm/actions/index.js"
    }
  },
  "module": "./_esm/index.js",
  "sideEffects": false,
  "types": "./_types/index.d.ts",
  "typesVersions": {
    "*": {
      "actions": [
        "./_types/actions/index.d.ts"
      ]
    }
  },
  "typings": "./_types/index.d.ts"
}
